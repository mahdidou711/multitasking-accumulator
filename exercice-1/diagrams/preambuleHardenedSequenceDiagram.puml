@startuml
box "Processus shell" #F3F3F3
participant "bash" as shell
end box
box "Processus programme : preambule (fils)" #EAF3FF
participant "thread principal : main" as main
participant "thread_1 : produce" as worker
participant "mutex : pthread_mutex_t" as mutex
participant "semaphore non nomme : sem_t" as sem
end box

shell -> main : lancer ./preambule
main -> sem : sem_init(&semaphore, 0, 0)
alt echec de sem_init
  sem --> main : erreur
  main -> main : retourner erreur
else initialisation reussie
  sem --> main : succes
  main -> main : pthread_create(&thread_1, ..., produce, ...)
  alt echec de creation
    main -> main : status = erreur
  else creation reussie
    par Thread principal
      main -> main : appeler pthread_join(thread_1, NULL)
    else Thread cree : produce
      worker -> mutex : pthread_mutex_lock
      alt echec lock
        worker -> worker : thread_error = 1; return
      else lock reussi
        worker -> mutex : pthread_mutex_unlock
        alt echec unlock
          worker -> worker : thread_error = 1; return
        else unlock reussi
          worker -> sem : sem_post
          alt echec sem_post
            worker -> worker : thread_error = 1; return
          else post reussi
            loop premier appel puis repetition si EINTR
              worker -> sem : sem_wait
              alt succes
                sem --> worker : succes ; sortir de la boucle
              else echec avec EINTR
                sem --> worker : EINTR ; recommencer
              else autre echec
                sem --> worker : erreur
                worker -> worker : thread_error = 1; return
              end
            end
            worker -> worker : return
          end
        end
      end
    end
    alt jointure reussie
      note right of main
        Retour apres la fin de thread_1 ;
        bloque si le thread est encore actif.
      end note
      main -> main : propager thread_error dans status
    else echec de jointure
      note right of main
        produce peut etre encore en cours.
        Retour sans sem_destroy ; la fin du processus
        interrompt ses threads.
      end note
      main -> main : retourner erreur
    end
  end
  opt creation echouee ou jointure reussie
    main -> sem : sem_destroy(&semaphore)
    alt echec de sem_destroy
      sem --> main : erreur
      main -> main : status = erreur
    else destruction reussie
      sem --> main : succes
    end
    main -> main : retourner status
  end
end
main --> shell : fin du processus / code de retour
@enduml
